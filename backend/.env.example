APP_NAME=CoPilotHub AI
ENVIRONMENT=development
DEBUG=false
DEMO_MODE=true

# Local dev (database from docker compose, port published on localhost)
DATABASE_URL=postgresql+psycopg2://copilothub:change_me_db_password@localhost:5432/copilothub

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace_with_a_long_random_string_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173