APP_NAME=CoPilotHub AI
ENVIRONMENT=development
DEBUG=false

# true  = deterministic demo agent (no LLM needed, tools are SIMULATED)
# false = use the local LLM below (falls back to demo mode if it is unreachable)
DEMO_MODE=true

# Local dev (database from docker compose, port published on localhost)
DATABASE_URL=postgresql+psycopg2://copilothub:change_me_db_password@localhost:5432/copilothub

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace_with_a_long_random_string_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=http://localhost:5173

# ---- Local LLM ----
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3
LLM_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0.2

# OPTIONAL - NOT REQUIRED. Only used when LLM_PROVIDER=openai_compatible.
# OPTIONAL_API_BASE_URL=http://localhost:1234/v1
# OPTIONAL_API_KEY=
# OPTIONAL_API_MODEL=

# ---- Agent limits ----
AGENT_MAX_STEPS=8
AGENT_MAX_RETRIES=2
AGENT_RETRY_BACKOFF_SECONDS=1.0
AGENT_STEP_DELAY_SECONDS=1.5
AGENT_STEP_TIMEOUT_SECONDS=180
AGENT_MAX_RUNTIME_SECONDS=900
# Human approval before the final summary is accepted (recommended)
AGENT_REQUIRE_FINAL_APPROVAL=true
AGENT_MAX_APPROVAL_ROUNDS=3
AGENT_MAX_REPLANS=3
# ---- RAG ----
DATA_DIR=../data
# sentence_transformers = semantic embeddings (downloads ~90MB once)
# hashing               = lexical fallback, works offline with no download
EMBEDDING_BACKEND=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=4
RAG_MIN_SCORE=0.15
MAX_UPLOAD_MB=10
MAX_DOCUMENTS_PER_SESSION=20
# ---- Tools ----
AGENT_TOOLS_ENABLED=true
AGENT_MAX_TOOL_CALLS_PER_STEP=3
AGENT_MAX_TOOL_CALLS_PER_RUN=40
TOOL_TIMEOUT_SECONDS=30
# Restrict the tools the agent may use (empty = all): e.g. retrieve_documents,read_document,calculate
AGENT_ENABLED_TOOLS=
# demo = built-in simulated results (offline, labelled "simulated")
# OPTIONAL - NOT REQUIRED: searxng (self-hosted, free) or duckduckgo (pip install duckduckgo-search)
WEB_SEARCH_PROVIDER=demo
SEARXNG_URL=

# ---- NLP classifier ----
NLP_AUTO_APPLY=true
NLP_AUTO_TRAIN=true