APP_NAME=CoPilotHub AI
ENVIRONMENT=development
DEBUG=false

# true  = deterministic demo agent (no LLM needed, tools are SIMULATED)
# false = use the local LLM below (falls back to demo mode if it is unreachable)
DEMO_MODE=true

# Local dev (database from docker compose, port published on localhost)
DATABASE_URL=postgresql+psycopg2://copilothub:change_me_db_password@localhost:5432/copilothub

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace_with_a_long_random_string_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=http://localhost:5173

# ---- Local LLM ----
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3
LLM_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0.2

# OPTIONAL - NOT REQUIRED. Only used when LLM_PROVIDER=openai_compatible.
# OPTIONAL_API_BASE_URL=http://localhost:1234/v1
# OPTIONAL_API_KEY=
# OPTIONAL_API_MODEL=

# ---- Agent limits ----
AGENT_MAX_STEPS=8
AGENT_MAX_RETRIES=2
AGENT_RETRY_BACKOFF_SECONDS=1.0
AGENT_STEP_DELAY_SECONDS=1.5
AGENT_STEP_TIMEOUT_SECONDS=180
AGENT_MAX_RUNTIME_SECONDS=900