# ---- Database (Docker) ----
POSTGRES_USER=copilothub
POSTGRES_PASSWORD=change_me_db_password
POSTGRES_DB=copilothub

# ---- Secret used to sign login tokens. Generate your own:
#      python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace_with_a_long_random_string_at_least_32_chars

# ---- Agent ----
# true  = built-in demo agent (no language model needed)
# false = use Ollama + Qwen3 (falls back to demo mode, with a visible warning, if Ollama is unreachable)
DEMO_MODE=true
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3

# sentence_transformers = semantic search (downloads ~90 MB once); hashing = offline fallback
EMBEDDING_BACKEND=sentence_transformers
WEB_SEARCH_PROVIDER=demo
ENVIRONMENT=development